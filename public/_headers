# Copied into ./out by `next build`. Cloudflare applies it and does not serve the file.
# Vercel ignores this file. There is no Content-Security-Policy: AdSense and
# Google Analytics load third-party scripts, and a CSP would block them.

# Hashed build assets. Filenames change when the contents change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Audio filenames are not hashed. Seven days, then revalidate.
/*.mp3
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: audio/mpeg

/*.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
  Content-Type: image/x-icon
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# This site has no generated /opengraph-image file. Social tags are title,
# description, and og:url only.

/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
